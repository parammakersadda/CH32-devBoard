#ignore everything by default
*
#do not ignore LICENSE and README
!LICENSE
!README.md
!.gitignore

#do not ignore kicad pcb files, schematic files, and project files
!*.kicad_pcb
!*.kicad_sch
!*.kicad_pro
!symbols/
!symbols/*.kicad_sym

#exports
!exports/
!exports/*
!exports/gerbers/*

!3dModels/
!3dModels/*

#do not ignore images
!images
!images/*

!PDFs/
!PDFs/*
